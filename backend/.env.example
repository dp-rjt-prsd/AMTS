# Copy to .env and fill in. SECRET_KEY and DATABASE_URL are required.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=mysql+pymysql://amts_user:CHANGE_ME@localhost/asset_management_system

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Exact frontend origins, comma separated. '*' is rejected at startup.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

LOGIN_RATE_LIMIT=10/minute

# Used only by seed.py. Reserved TLDs (.local, .test, .invalid) are refused,
# since an admin created with one could never log in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMP_ID=EMP001
